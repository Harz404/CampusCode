{
  "name": "campuscode-server",
  "version": "1.0.0",
  "type": "module",
  "description": "CampusCode Express & MongoDB API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/seeder.ts",
    "clear": "tsx src/seed/clear.ts",
    "test": "npm run build && node --test",
    "test:integration": "npm run build && node --test integration/transactions.integration.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "mongodb-memory-server-core": "^10.4.3",
    "smtp-server": "^3.21.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
