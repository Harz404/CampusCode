PORT=5000
MONGODB_URI=mongodb+srv
JWT_SECRET=secret
CLIENT_URL=http://localhost:5000
NODE_ENV=development

# Account verification/recovery delivery (optional until configured).
# APP_PUBLIC_URL must use HTTPS in production. Never derive email links from request headers.
APP_PUBLIC_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
# Generate a random 32-byte key, encoded as base64, for encrypted queued mail.
MAIL_ENCRYPTION_KEY=
# Only permits plaintext SMTP to loopback in non-production local tests.
SMTP_ALLOW_INSECURE_LOCAL=false
